{
  "gpu_python": "",
  "gpu_env": "",
  "server": {
    "auth": "accounts",
    "host": "127.0.0.1",
    "port": 8080,
    "retention_days": 30,
    "device": "auto",
    "allowed_folders": []
  },
  "report": {
    "enabled": false,
    "provider": "gateway",
    "url": "http://127.0.0.1:8095/v1",
    "model": "openai/gpt6_luna",
    "key_env": "RETIVASC_REPORT_KEY",
    "key_file": "~/.config/lab-llm/apps/retivasc.key",
    "origins": ["https://retinal-research.github.io"],
    "window_seconds": 60,
    "per_window": 3,
    "per_ip_per_day": 30,
    "per_day": 500,
    "max_tokens": 4000
  }
}
